APP_NAME="Health Assist"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BLOCKCHAIN_VERIFICATION_ENABLED=false
BLOCKCHAIN_PROVIDER=

AI_PROVIDER=mock
AI_OPENAI_BASE_URL=
AI_OPENAI_API_KEY=
AI_OPENAI_DEFAULT_MODEL=gpt-4o-mini
AI_METERING_ENABLED=true
AI_ENFORCE_QUOTAS=true
AI_MONTHLY_REQUEST_LIMIT=5000
AI_MONTHLY_TOKEN_LIMIT=2000000
# Set AI_PROVIDER=openai_compatible and AI_OPENAI_API_KEY to use a live OpenAI-compatible API.
# Re-run AiCoreSeeder (or migrate:fresh --seed) so openai-chat external_model_id matches AI_OPENAI_DEFAULT_MODEL.

# Report AI OCR (mock|null — no paid cloud OCR in CI)
OCR_DRIVER=mock

# WhatsApp via Evolution API (do not use Meta Cloud API directly)
WHATSAPP_DRIVER=evolution
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_DEFAULT_INSTANCE=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_REMINDERS_ENABLED=true
# WHATSAPP_PROCESS_SYNC=false

# Marketing analytics (empty credentials = drivers no-op / log only; never call live vendors in CI)
MARKETING_ANALYTICS_ENABLED=true
MARKETING_ANALYTICS_DRIVERS=log
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
MIXPANEL_TOKEN=
FIREBASE_APP_ID=
MARKETING_PUBLIC_SITE_URL="${APP_URL}"

# Mobile deep links (Phase 14)
MOBILE_APP_SCHEME=healthassist
MOBILE_APP_HOSTS=localhost,healthassist.app
